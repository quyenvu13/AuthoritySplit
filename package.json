{
  "name": "authoritysplit",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "checksums": "node scripts/checksums.mjs",
    "lint:genvm": "python3 -m genvm_linter.cli lint contracts/AuthoritySplit.py",
    "test:direct": "python3 -m pytest tests/direct -q",
    "test:mutations": "python3 scripts/mutation_matrix.py",
    "check": "npm run verify && npm run lint:genvm && npm run test:direct && npm run test:mutations && npm run build"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
